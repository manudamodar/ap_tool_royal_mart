# --- Django Migrations (Your specific request) ---
# This ignores all migration files but keeps the folders and __init__.py
**/migrations/*.py
!**/migrations/__init__.py

# --- Frontend (The source of your 37k files) ---
# This will fix the slow VCS adding issue
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Virtual Environments ---
venv/
env/

